{
  "name": "weather",
  "version": "1.0.0",
  "private": true,
  "description": "A fast, private weather dashboard built with Next.js server components and OpenWeatherMap.",
  "homepage": "https://weather.sacrificed.me",
  "license": "MIT",
  "author": "Illia Movchko (https://github.com/sacrificed666)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sacrificed666/weather.git"
  },
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "lint:text": "node scripts/check-text.mjs",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "icons": "node scripts/sync-icons.mjs",
    "check": "npm run lint && npm run lint:text && npm run format:check && npm run typecheck && npm run test:run"
  },
  "dependencies": {
    "country-flag-icons": "^1.6.20",
    "next": "^16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@meteocons/svg": "^0.1.0",
    "@meteocons/svg-static": "^0.1.0",
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "babel-plugin-react-compiler": "^1.0.0",
    "jsdom": "^30.1.3",
    "lighthouse": "^13.5.0",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2005",
    "sass": "^1.105.2",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=24"
  },
  "allowScripts": {
    "@parcel/watcher": false,
    "fsevents": false
  },
  "monitor": {
    "paths": [
      "/healthz",
      "/en",
      "/.well-known/security.txt",
      "/robots.txt",
      "/sitemap.xml",
      "/api/places?q=Kyiv"
    ],
    "pages": [
      "/en",
      "/uk"
    ]
  }
}
