# A key from https://home.openweathermap.org/api_keys, used only on the server
OPENWEATHERMAP_API_KEY=
# Optional: another OpenWeatherMap-compatible host, such as the test mock
OPENWEATHERMAP_API_URL=
# Optional on Vercel: the public address for links, the sitemap and share cards
SITE_URL=
# Docker only: the host port (3000 development and production, 3001 staging)
APP_PORT=
